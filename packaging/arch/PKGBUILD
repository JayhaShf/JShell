# Maintainer: JShell contributors

pkgname=jshell
pkgver=1.0.0
pkgrel=1
pkgdesc="SSH, SFTP and local terminal workspace built with GPUI"
arch=('x86_64')
url="https://github.com/JayhaShf/JShell"
license=('GPL-3.0-or-later')
depends=(
  'libxcb'
  'libxkbcommon'
  'libxkbcommon-x11'
  'mesa'
  'wayland'
  'libayatana-appindicator'
)
makedepends=(
  'clang'
  'git'
  'nasm'
  'rust'
)
options=(!lto !debug)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('936683658faeaf7d1e087ad98ac6986027f7501705a411495b3375ef297c0b09')

prepare() {
  cd "$srcdir/JShell-$pkgver"
  cargo fetch --locked
}

build() {
  cd "$srcdir/JShell-$pkgver"
  cargo build --frozen --release
}

package() {
  cd "$srcdir/JShell-$pkgver"

  install -Dm755 target/release/jshell "$pkgdir/usr/bin/jshell"
  install -Dm644 assets/jshell.desktop \
    "$pkgdir/usr/share/applications/jshell.desktop"
  install -Dm644 assets/icons/jshell.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/jshell.png"
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 assets/fonts/OFL-1.1.txt \
    "$pkgdir/usr/share/licenses/$pkgname/OFL-1.1.txt"
  install -Dm644 assets/fonts/SOURCE.zh-CN.md \
    "$pkgdir/usr/share/licenses/$pkgname/Noto-CJK-SOURCE.zh-CN.md"
}
